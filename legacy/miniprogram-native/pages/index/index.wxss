.home-page {
  padding-bottom: 172rpx;
}

.home-header {
  padding: 18rpx 0 18rpx;
}

.home-header .brand,
.home-header .headline,
.home-header .subtitle {
  text-align: left;
}

.home-header .brand {
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 0;
}

.headline {
  margin-top: 8rpx;
  color: #1a1a1a;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.home-header .subtitle {
  max-width: 560rpx;
  margin-top: 10rpx;
  line-height: 1.45;
}

.memory-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.memory-title {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.compact-btn {
  width: 188rpx;
  flex: 0 0 188rpx;
  min-height: 72rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.toolbar {
  position: sticky;
  top: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 10rpx 0 14rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 248, 242, 0.96);
}

.filter-tabs,
.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.toolbar-actions {
  min-width: 0;
}

.filter-tabs {
  flex: 0 0 auto;
  padding: 6rpx;
  border: 2rpx solid #ffe4d3;
  border-radius: 999rpx;
  background: #fff;
}

.toolbar-actions {
  flex: 0 0 auto;
}

.filter-tab,
.link-btn,
.clear-btn {
  margin: 0;
  border: 0;
  background: transparent;
  color: #6b6b6b;
  font-size: 26rpx;
  line-height: 64rpx;
}

.filter-tab {
  min-width: 104rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
}

.filter-tab-active {
  background: #ff6b35;
  color: #fff;
  font-weight: 800;
}

.link-btn {
  min-height: 66rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ffe4d3;
  border-radius: 999rpx;
  background: #fff;
  color: #ff6b35;
  font-weight: 700;
}

.link-btn-active {
  background: #fff1e8;
  color: #1a1a1a;
}

.filter-tab::after,
.link-btn::after,
.clear-btn::after,
.dish-main::after,
.dish-save::after {
  border: none;
}

.search-wrap {
  display: grid;
  grid-template-columns: 1fr 112rpx;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.search-wrap-solo {
  grid-template-columns: 1fr;
}

.search-input {
  min-height: 78rpx;
  padding: 0 22rpx;
  border: 2rpx solid #ffe4d3;
  border-radius: 18rpx;
  background: #fff;
  font-size: 27rpx;
  box-sizing: border-box;
}

.search-status {
  grid-column: 1 / -1;
  color: #8a7468;
  font-size: 23rpx;
  font-weight: 700;
}

.clear-btn {
  min-height: 78rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #ff6b35;
  line-height: 78rpx;
}

.dish-list {
  display: grid;
  gap: 14rpx;
}

.dish-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 116rpx;
  gap: 12rpx;
  align-items: stretch;
  padding: 16rpx;
  border: 2rpx solid #ffe4d3;
  border-radius: 22rpx;
  background: #fff;
}

.dish-row-selected {
  border-color: #ff6b35;
  background: #fff5ee;
}

.dish-main {
  min-width: 0;
  min-height: 104rpx;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  column-gap: 14rpx;
  align-items: center;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #1a1a1a;
  text-align: left;
  line-height: 1.35;
}

.dish-status {
  grid-row: 1 / 3;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff8f2;
  color: #ff6b35;
  font-size: 20rpx;
  font-weight: 800;
}

.dish-row-selected .dish-status {
  background: #ff6b35;
  color: #fff;
}

.dish-name {
  min-width: 0;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  min-width: 0;
  color: #6b6b6b;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-save {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 2rpx solid #ffe4d3;
  border-radius: 18rpx;
  background: #fff;
  color: #ff6b35;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.dish-save-active {
  border-color: #ff6b35;
  background: #ff6b35;
  color: #fff;
}

.empty-card {
  padding: 40rpx 28rpx;
  border: 2rpx dashed #ffe4d3;
  border-radius: 22rpx;
  background: #fff;
  text-align: center;
}

.empty-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  color: #6b6b6b;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-action {
  min-height: 72rpx;
  margin: 24rpx auto 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.empty-action::after {
  border: 0;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  display: grid;
  grid-template-columns: 1fr 220rpx;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #ffe4d3;
  background: rgba(255, 248, 242, 0.96);
  box-sizing: border-box;
}

.submit-copy {
  min-width: 0;
}

.submit-title {
  font-size: 30rpx;
  font-weight: 800;
}

.submit-desc {
  margin-top: 4rpx;
  color: #6b6b6b;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  min-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.submit-btn-disabled {
  background: #d6ccc5;
  color: rgba(255, 255, 255, 0.86);
}
