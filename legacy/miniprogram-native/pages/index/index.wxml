<view class="page home-page safe-bottom">
  <view class="home-header">
    <view class="brand">今天吃什么</view>
    <view class="headline">点几道想吃的菜</view>
    <view class="subtitle">选好后直接生成买菜清单、按点上桌计划和每道菜做法</view>
  </view>

  <view wx:if="{{lastChoice}}" class="memory-card">
    <view class="memory-title">上次选了：{{lastChoiceTitle}}</view>
    <button class="secondary-btn compact-btn" bindtap="useLastChoice">继续看这桌</button>
  </view>

  <view class="toolbar">
    <view class="filter-tabs">
      <button data-filter="all" bindtap="setFilter" class="filter-tab {{filter === 'all' ? 'filter-tab-active' : ''}}">全部</button>
      <button data-filter="saved" bindtap="setFilter" class="filter-tab {{filter === 'saved' ? 'filter-tab-active' : ''}}">收藏</button>
    </view>
    <view class="toolbar-actions">
      <button class="link-btn {{searchOpen ? 'link-btn-active' : ''}}" bindtap="toggleSearch">{{searchOpen ? '收起' : '搜索'}}</button>
      <button class="link-btn" bindtap="refreshDishes">刷新</button>
    </view>
  </view>

  <view wx:if="{{searchOpen}}" class="search-wrap {{searchQuery ? '' : 'search-wrap-solo'}}">
    <input class="search-input" value="{{searchQuery}}" placeholder="搜菜名、分类、口味或食材" bindinput="updateSearch" />
    <button wx:if="{{searchQuery}}" class="clear-btn" bindtap="clearSearch">清空</button>
    <view wx:if="{{dishCountLabel}}" class="search-status">{{dishCountLabel}}</view>
  </view>

  <view class="dish-list">
    <view wx:for="{{dishes}}" wx:key="name" class="dish-row {{item.selected ? 'dish-row-selected' : ''}}">
      <button class="dish-main" data-name="{{item.name}}" bindtap="toggleDish">
        <text class="dish-status">{{item.selected ? '已选' : '可选'}}</text>
        <text class="dish-name">{{item.name}}</text>
        <text class="dish-meta">{{item.category}} · {{item.time}} 分钟 · {{item.note}}</text>
      </button>
      <button class="dish-save {{item.saved ? 'dish-save-active' : ''}}" data-name="{{item.name}}" bindtap="toggleSaved">
        <text>{{item.saved ? '已收藏' : '收藏'}}</text>
      </button>
    </view>
  </view>

  <view wx:if="{{!dishes.length}}" class="empty-card">
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-desc">{{emptyDesc}}</view>
    <button class="empty-action" bindtap="showAllDishes">去全部看看</button>
  </view>

  <view class="submit-bar">
    <view class="submit-copy">
      <view class="submit-title">{{submitTitle}}</view>
      <view class="submit-desc">{{submitDesc}}</view>
    </view>
    <button class="primary-btn submit-btn {{canSubmit ? '' : 'submit-btn-disabled'}}" disabled="{{canSubmit ? false : true}}" bindtap="generateRecipe">生成菜谱</button>
  </view>
</view>
